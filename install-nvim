#!/bin/sh
# Put glinter on Neovim's runtimepath. No plugin manager. No init.lua.
set -eu

say() {
  printf 'glinter: %s\n' "$*"
}

die() {
  printf 'glinter: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Install glinter for Neovim. No plugin manager. No init.lua.

Usage:
  ./install-nvim            Link this clone into Neovim's plugin folder
  ./install-nvim --try      Install, then open a sample commit message
  ./install-nvim --check    Verify Neovim loads glinter
  ./install-nvim --uninstall
  ./install-nvim --help

After install, set git to use Neovim and commit as usual:

  git config --global core.editor nvim
  git commit

Quit the sample with :q
EOF
}

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
[ -f "$ROOT/plugin/glinter.lua" ] || die "run this from a glinter clone"

cmd=--install
seen=
while [ $# -gt 0 ]; do
  case "$1" in
    --try|--check|--uninstall|-h|--help)
      [ -z "$seen" ] || die "use one option (see --help)"
      cmd=$1
      seen=1
      ;;
    *)
      die "unknown option: $1 (see --help)"
      ;;
  esac
  shift
done
if [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ]; then
  usage
  exit 0
fi

need_nvim() {
  if ! command -v nvim >/dev/null 2>&1; then
    if command -v vim >/dev/null 2>&1; then
      die "found vim, but glinter needs Neovim. Install it from https://neovim.io"
    fi
    die "Neovim not found. Install it from https://neovim.io then re-run ./install-nvim"
  fi
}

nvim_ok_version() {
  nvim --headless -u NONE -i NONE -n \
    -c 'if has("nvim-0.7") | qa! | else | cquit 1 | endif' \
    >/dev/null 2>&1
}

nvim_data() {
  nvim --headless -u NONE -i NONE -n \
    -c "lua io.stdout:write(vim.fn.stdpath('data'))" \
    -c qa
}

same_dir() {
  [ -d "$1" ] && [ -d "$2" ] || return 1
  _a=$(CDPATH= cd -P -- "$1" && pwd) || return 1
  _b=$(CDPATH= cd -P -- "$2" && pwd) || return 1
  [ "$_a" = "$_b" ]
}

need_nvim
nvim_ok_version || die "Neovim 0.7 or newer is required ($(nvim --version | head -n 1))"

DATA=$(nvim_data) || die "could not read Neovim data directory"
DATA=$(printf '%s' "$DATA" | tr -d '\r\n')
[ -n "$DATA" ] || die "could not read Neovim data directory"
DEST=$DATA/site/pack/glinter/start/glinter

plugin_loaded() {
  nvim --headless -u NORC -i NONE -n \
    -c 'if exists(":GlinterRefresh") == 2 | qa! | else | cquit 1 | endif' \
    >/dev/null 2>&1
}

git_editor() {
  if [ -n "${GIT_EDITOR-}" ]; then
    printf '%s' "$GIT_EDITOR"
    return
  fi
  _ed=$(git config --get core.editor 2>/dev/null || true)
  if [ -n "$_ed" ]; then
    printf '%s' "$_ed"
    return
  fi
  if [ -n "${VISUAL-}" ]; then
    printf '%s' "$VISUAL"
    return
  fi
  if [ -n "${EDITOR-}" ]; then
    printf '%s' "$EDITOR"
    return
  fi
  printf '%s' "vi"
}

hint_git_editor() {
  _ed=$(git_editor)
  case "$_ed" in
    *nvim*)
      return 0
      ;;
  esac
  say "git is not using Neovim (editor: $_ed)"
  say "  git config --global core.editor nvim"
}

link_plugin() {
  mkdir -p "$(dirname -- "$DEST")"

  if [ -L "$DEST" ] && [ ! -e "$DEST" ]; then
    say "remove broken link $DEST"
    rm "$DEST"
  fi

  if [ -d "$DEST" ] || [ -L "$DEST" ]; then
    if same_dir "$DEST" "$ROOT"; then
      say "already installed at $DEST"
      return 0
    fi
    die "$DEST already exists. ./install-nvim --uninstall to remove a glinter link"
  fi

  ln -s "$ROOT" "$DEST"
  say "linked $DEST"
  say "  -> $ROOT"
}

after_install() {
  if plugin_loaded; then
    say "Neovim loads glinter. No plugin manager. No init.lua."
  else
    die "link is in place, but Neovim did not load glinter. Open an issue."
  fi
  hint_git_editor
  say "restart Neovim, then: git commit"
  if [ "$cmd" != "--try" ]; then
    say "or try a sample: ./install-nvim --try"
  fi
}

uninstall() {
  if [ -L "$DEST" ]; then
    rm "$DEST"
    say "removed $DEST"
    return 0
  fi
  if [ -d "$DEST" ]; then
    if same_dir "$DEST" "$ROOT"; then
      die "this clone is $DEST; delete the clone itself if you want it gone"
    fi
    die "$DEST is a directory, not a link. Remove it by hand if you installed that way"
  fi
  say "nothing to remove ($DEST is not installed)"
}

write_sample() {
  _sample=$1
  cat >"$_sample" <<'EOF'
fixed the thing.

Added a really comprehensive implementation that utilizes extra words.

# Please enter the commit message for your changes. Lines starting
# with '#' will be ignored, and an empty message aborts the commit.
EOF
}

try_sample() {
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    die "--try needs a terminal. Run ./install-nvim --try from a prompt"
  fi
  _dir=$(mktemp -d)
  trap 'rm -rf "$_dir"' EXIT
  write_sample "$_dir/COMMIT_EDITMSG"
  say "sample commit message. yellow/red/blue/green highlights are glinter."
  say "quit Neovim with :q"
  nvim -n "$_dir/COMMIT_EDITMSG"
}

case "$cmd" in
  --install)
    link_plugin
    after_install
    ;;
  --try)
    link_plugin
    after_install
    try_sample
    ;;
  --check)
    if [ ! -d "$DEST" ] && [ ! -L "$DEST" ]; then
      die "not installed ($DEST missing). Run ./install-nvim"
    fi
    if plugin_loaded; then
      say "ok ($DEST)"
    else
      die "Neovim did not load glinter from $DEST"
    fi
    ;;
  --uninstall)
    uninstall
    ;;
  *)
    die "unknown command"
    ;;
esac
