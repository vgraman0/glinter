-- Rockspec template for lumen-oss/luarocks-tag-release.
-- The action fills the placeholders in from the tag and the repository.
-- It matches the action's own template, plus the `install` block that puts
-- the `glinter` CLI on PATH.
local git_ref = '$git_ref'
local modrev = '$modrev'
local specrev = '$specrev'

local repo_url = '$repo_url'

rockspec_format = '3.0'
package = '$package'
version = modrev ..'-'.. specrev

description = {
  summary = '$summary',
  detailed = $detailed_description,
  labels = $labels,
  homepage = '$homepage',
  $license
}

dependencies = $dependencies

test_dependencies = $test_dependencies

source = {
  url = repo_url .. '/archive/' .. git_ref .. '.zip',
  dir = '$repo_name-' .. '$archive_dir_suffix',
}

if modrev == 'scm' or modrev == 'dev' then
  source = {
    url = repo_url:gsub('https', 'git')
  }
end

build = {
  type = 'builtin',
  copy_directories = $copy_directories,
  install = {
    -- LuaRocks wraps this script, so `glinter` finds the installed modules.
    bin = {
      glinter = 'bin/glinter.lua',
    },
  },
}
